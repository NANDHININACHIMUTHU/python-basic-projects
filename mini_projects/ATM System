# ATM System
#A mini Python ATM simulation program that allows users to:
#-Check account balance  
#-Deposit money  
#-Withdraw money  
#-Exit the system  
#It uses loops and conditional statements to perform real-time balance updates.

balance=1000
print("ATM SYSTEM")
while True:
    print("\n1. Check Balance")
    print("2. Deposit")
    print("3. Withdraw")
    print("4. Exit")

    ch = int(input("Enter your choice: "))

    if ch==1:
        print("The ATM Balance Amount is", balance)
    elif ch==2:
        print("Enter the Deposit Amount")
        deposit=int(input())
        balance=balance+deposit
        print("The updated balance ampunt is", balance)
    elif ch==3:
        print("Enter the withdraw amount")
        amount=int(input())
        if balance>=amount:
            balance=balance-amount
            print("The remaining balance is", balance)
        else:
            print("The amount is insufficient")
    elif ch==4:
        print("Thank you! ATM Closed.")
        break
    else:
        print("Invalid option,try again")
